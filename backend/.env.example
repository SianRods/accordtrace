# Copy to backend/.env; replace placeholders. Do not commit backend/.env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ACCORDTRACE_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Docker Compose uses these service addresses. CLI inside containers inherits them.
ACCORDTRACE_DATABASE_URL=postgresql+psycopg://accordtrace:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/accordtrace
ACCORDTRACE_NEO4J_URI=bolt://neo4j:7687
ACCORDTRACE_NEO4J_USER=neo4j
ACCORDTRACE_NEO4J_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ACCORDTRACE_QDRANT_URL=http://qdrant:6333
ACCORDTRACE_SOURCE_DIR=/sources

# Standard Gemini API only; use a free-tier project. Never paste keys into chat.
ACCORDTRACE_GEMINI_API_KEY=
ACCORDTRACE_GEMINI_FREE_TIER_CONFIRMED=false
ACCORDTRACE_EMBEDDING_REQUESTS_PER_MINUTE=5
# JSON list of approved backend/configs/manifests/<id>.yaml names. Default: none.
ACCORDTRACE_APPROVED_MANIFESTS=[]

# Phase 3: stable owner survives bearer-token rotation. Do not change for existing conversations.
ACCORDTRACE_LOCAL_PRINCIPAL_ID=local
ACCORDTRACE_GROQ_API_KEY=
ACCORDTRACE_GROQ_FREE_TIER_CONFIRMED=false
ACCORDTRACE_CHAT_ACTIVE_SECONDS=30
ACCORDTRACE_CHAT_LIFETIME_SECONDS=600
ACCORDTRACE_CHAT_PROVIDER_TIMEOUT_SECONDS=20
# Conservative local controls; configure within your verified account limits.
ACCORDTRACE_CHAT_GROQ_RPM=30
ACCORDTRACE_CHAT_GROQ_TPM=8000
ACCORDTRACE_CHAT_GROQ_RPD=1000
ACCORDTRACE_CHAT_GROQ_TPD=200000
ACCORDTRACE_CHAT_GEMINI_RPM=5
ACCORDTRACE_CHAT_GEMINI_TPM=6000
ACCORDTRACE_CHAT_GEMINI_RPD=100
