# Copy to backend/.env; replace placeholders. Do not commit backend/.env.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
NEO4J_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ACCORDTRACE_API_TOKEN=REPLACE_WITH_RANDOM_TOKEN
# Docker Compose uses these service addresses. CLI inside containers inherits them.
ACCORDTRACE_DATABASE_URL=postgresql+psycopg://accordtrace:REPLACE_WITH_RANDOM_PASSWORD@postgres:5432/accordtrace
ACCORDTRACE_NEO4J_URI=bolt://neo4j:7687
ACCORDTRACE_NEO4J_USER=neo4j
ACCORDTRACE_NEO4J_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
ACCORDTRACE_QDRANT_URL=http://qdrant:6333
ACCORDTRACE_SOURCE_DIR=/sources
