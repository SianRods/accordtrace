# All testbed credentials/configuration belong here, never in backend/.env.
TESTBED_BACKEND_URL=http://127.0.0.1:8000
TESTBED_BACKEND_API_TOKEN=
TESTBED_SOURCE_DIR=../data/maud/MAUD_v1/contracts
TESTBED_OLLAMA_URL=http://127.0.0.1:11434
TESTBED_OLLAMA_MODEL=embeddinggemma:300m
# Judge-only; never used to generate embeddings or chatbot answers.
TESTBED_GEMINI_API_KEY=
# Explicit model with current free-tier eligibility, verified before a live judge run.
TESTBED_GEMINI_MODEL=gemini-2.5-flash-lite
TESTBED_GEMINI_FREE_TIER_CONFIRMED=false
TESTBED_JUDGE_REQUESTS_PER_MINUTE=2
TESTBED_JUDGE_MAX_CALLS=40
TESTBED_REQUEST_TIMEOUT_SECONDS=30
TESTBED_CHAT_WAIT_SECONDS=660
